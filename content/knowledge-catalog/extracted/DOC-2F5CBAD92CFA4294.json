auration\" id=\"res3\" value=\"1\">Peu satisfaisant\r\n                            </th>\r\n                        </tr>\r\n                        <tr>\r\n                            <th>Extra :</th>\r\n                            <th>\r\n                                <input type=\"checkbox\" name=\"Extra1\" id=\"ex1\" value=\"4\">Piscine couverte <br>\r\n                                <input type=\"checkbox\" name=\"Extra2\" id=\"ex2\" value=\"2\">Plage privée <br>\r\n                                <input type=\"checkbox\" name=\"Extra3\" id=\"ex3\" value=\"1\">Couverture Wifi <br>\r\n                            </th>\r\n                        </tr>\r\n                    </table>\r\n                </div>\r\n                <div id=\"zoneCaptcha\">\r\n                    <label for=\"cap\" class=\"right\">Captcha :</label>\r\n                    <input type=\"text\" id=\"cap\" disabled>\r\n                    <input type=\"button\" value=\"Actualiser\" onclick=\"GenererCaptcha()\"><br>\r\n                    <p>Combien de lettres majuscules dans la zone Captcha ?</p>\r\n                    <label for=\"rep\" class=\"right\">Reponse :</label>\r\n                    <input type=\"text\" id=\"rep\">\r\n                </div>\r\n                <div id=\"zoneBtn\">\r\n                    <input type=\"reset\" value=\"annuler\">\r\n                    <input type=\"submit\" value=\"Valider\" id=\"val\">\r\n                </div>\r\n            </form>\r\n        </fieldset>\r\n    </main>\r\n    <script src=\"control.js\"></script>\r\n</body>\r\n\r\n</html>",
