  "textSnippet": "<!DOCTYPE html> <html> <head> <title>Formulaire Calcul</title> <script type=\"text/javascript\"> function Calculer() { a=Number(document.f.z1.value); b=Number(document.f.z2.value); if(document.f.b[0].checked) {alert(\"Le Resultat est: \"+(a+b));} if(document.f.b[1].checked) {alert(\"Le Resultat est: \"+(a-b));} if(document.f.b[2].checked) {alert(\"Le Resultat est: \"+(a*b));} if(document.f.b[3].checked) {alert(\"Le Resultat est: \"+(a/b));} }; </s",
  "fullText": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n\t<title>Formulaire Calcul</title>\r\n\t<script type=\"text/javascript\">\r\n\t\tfunction Calculer() {\r\n\t\t \ta=Number(document.f.z1.value);\r\n\t\t\tb=Number(document.f.z2.value);\r\n\t\t\tif(document.f.b[0].checked)\r\n\t\t\t\t{alert(\"Le Resultat est: \"+(a+b));}\r\n\t\t\tif(document.f.b[1].checked)\r\n\t\t\t\t{alert(\"Le Resultat est: \"+(a-b));}\r\n\t\t\tif(document.f.b[2].checked)\r\n\t\t\t\t{alert(\"Le Resultat est: \"+(a*b));}\r\n\t\t\tif(document.f.b[3].checked)\r\n\t\t\t\t{alert(\"Le Resultat est: \"+(a/b));}\r\n\t\t};\r\n\t</script>\r\n</head>\r\n<body>\r\n\t<form name=\"f\">\r\n\t<center><h2>Formulaire Pour Calculer Deux Valeurs</h2></center>\r\n\t<p>Valeur 1: <input type=\"text\" name=\"z1\"></p>\r\n\t<p>Valeur 2: <input type=\"text\" name=\"z2\"></p>\r\n\t<p> <input type=\"radio\" name=\"b\" value=\"0\"> +</p>\r\n\t<p> <input type=\"radio\" name=\"b\" value=\"1\"> -</p>\r\n\t<p> <input type=\"radio\" name=\"b\" value=\"2\"> *</p>\r\n\t<p> <input type=\"radio\" name=\"b\" value=\"3\"> /</p>\r\n\t<input type=\"submit\"  value=\"calculer\" name=\"b1\" onclick=\"Calculer()\">\r\n</form>\r\n</body>\r\n</html>",
