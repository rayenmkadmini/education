el>\r\n                <textarea name=\"\" id=\"adr\" cols=\"25\" rows=\"5\"></textarea><br>\r\n                <label for=\"ville\" class=\"largeur label\">Ville</label>\r\n                <select class=\"largeur1\" id=\"ville\">\r\n                    <option value=\"choix\">Choisir une ville</option>\r\n                    <option value=\"Tunis\">Tunis</option>\r\n                    <option value=\"Ariana\">Ariana</option>\r\n                    <option value=\"Ben Arous\">Ben Arous</option>\r\n                    <option value=\"Autre\">Autre...</option>\r\n                </select><br>\r\n                <input type=\"checkbox\" id=\"news\">\r\n                <label for=\"news\" id=\"label\">Recevoir notifications</label>\r\n                <div class=\"center\">\r\n                    <input type=\"submit\" value=\"Ajouter\" />\r\n                    <input type=\"reset\" value=\"Annuler\" />\r\n                </div>\r\n            </fieldset>\r\n        </form>\r\n    </main>\r\n    <footer>\r\n        <div>\r\n            <img class=\"ft\" src=\"files/tel.png\" />\r\n            <p>besoin d'aide? 71717171</p>\r\n        </div>\r\n        <div id=\"div\">\r\n            <p>suivez-nous:</p>\r\n            <a href=\"http://www.facebook.com\"><img class=\"ft2\" src=\"files/fblogo.png\" id=\"fb\" /></a>\r\n            <a href=\"http://www.twiter.com\"><img class=\"ft2\" src=\"files/ttlogo.png\" id=\"tt\" /></a>\r\n            <a href=\"http://www.youtube.com\"><img class=\"ft2\" src=\"files/ytlogo.png\" id=\"yt\" /></a>\r\n            <a href=\"http://www.instagram.com\"><img class=\"ft2\" src=\"files/instalogo.png\" id=\"ins\" /></a>\r\n        </div>\r\n        </div>\r\n    </footer>\r\n</body>\r\n\r\n</html",
