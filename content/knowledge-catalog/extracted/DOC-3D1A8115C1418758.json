der=\"500\">caractères<br>\r\n            <input type=\"checkbox\" id=\"conditions\" onfocus=\"activebt()\">\r\n            <label for=\"conditions\">J'accepte les termes et conditions générales</label>\r\n            <hr>\r\n            <div class=\"centrer\" onmouseover=\"couleur()\">\r\n                <input id=\"inscrire\" type=\"submit\" value=\"S'inscrire\" class=\"bt\" disabled>\r\n                <input id=\"annuler\" type=\"reset\" value=\"Annuler\" class=\"bt\">\r\n                </div>\r\n        </fieldset>\r\n    </form>\r\n</body>\r\n\r\n</html>",
