  "fullText": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n\t<meta charset=\"utf-8\">\r\n\t<title>Moyen eleves</title>\r\n\t<script type=\"text/javascript\">\r\n\t\tvar n=parseInt(prompt(\"Donner N=\"));\r\n\t\tvar moy=new Array();\r\n\t\tfor(var i=0; i<n; i++)\r\n\t\t{\r\n\t\t\tmoy[i]=parseFloat(prompt(\"Moyenne eleve :\"+(i+1)));\r\n\t\t}\r\n\t\tvar s=0;\r\n\t\tfor(i=0 ; i<n ; i++)\r\n\t\t{\r\n\t\t\ts=s+moy[i];\r\n\t\t}\r\n\t\tdocument.write(\"Moyenne de la classe =\"+(s/n));\r\n\t\tvar nb=0;\r\n\t\tfor(i=0;i<n;i++)\r\n\t\t{\r\n\t\t\tif(moy[i]>=10)\r\n\t\t\t{\r\n\t\t\t\tnb=nb+1;\r\n\t\t\t}\r\n\t\t}\r\n\t\tvar p=(nb/n)*100;\r\n\t\tdocument.write(\"<br>Pourcentage de reussite =\"+p+\"%\");\r\n\t\tvar max = moy[0];\r\n\t\tfor(i=0 ; i<n ;i++)\r\n\t\t{\r\n\t\t\tif (max<moy[i])\r\n\t\t\t{\r\n\t\t\t\tmax=moy[i];\r\n\t\t\t}\r\n\t\t}\r\n\t\tdocument.write(\"<br> La meilleur moyenne de la classe est: \"+max);\r\n\t</script>\r\n</head>\r\n<body>\r\n\r\n</body>\r\n</html>",
